# Recommended for the GitHub Actions + Pages deploy: nothing to set here —
# the workflow's built-in GITHUB_TOKEN handles it automatically.
#
# For local/Railway use instead, generate a PAT with the `models: read`
# scope at https://github.com/settings/personal-access-tokens
GITHUB_MODELS_TOKEN=

# Alternative providers (only used if GITHUB_MODELS_TOKEN isn't set):
# GROQ_API_KEY=       # https://console.groq.com/keys — free, no age gate
# GEMINI_API_KEY=     # https://aistudio.google.com/apikey — needs age-verified Google account

# Optional overrides
GITHUB_MODEL=openai/gpt-4o-mini
YT_CHANNEL_ID=UCXuqSBlHAE6Xw-yeJA0Tunw
CRON_SCHEDULE=0 */3 * * *
PORT=3000
